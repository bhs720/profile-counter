+/* fz_open_compressed_buffer() only decodes the sample oriented compressions.
+ * The "full image formats" -- JPX, PNG, TIFF, BMP, GIF, PNM, PSD, JXR -- fall
+ * through the switch in fz_open_image_decomp_stream() and are handed back still
+ * encoded, so sampling that stream reads compressed bytes as if they were
+ * pixels. Whatever the file's header and entropy coded data happen to contain
+ * decides the colour verdict, and since that data is effectively random no
+ * threshold below 1 can suppress it.
+ *
+ * JPX shows this most clearly because its magic number is fixed: offset 3 of
+ * every JP2 signature box is 0C 6A 50, a channel spread of 94, so detection
+ * trips on the ASCII "jP" at the second pixel before anything is decoded.
+ *
+ * It is not only a PDF concern. Inside a PDF only JPXDecode reaches this path,
+ * but this project also opens standalone images, where BMP, PNG and PNM files
+ * arrive here directly -- a 1bpp black and white BMP scan and a greyscale PNG
+ * were both reported as colour, and both render with a maximum per-pixel
+ * channel spread of zero.
+ *
+ * Decode a pixmap for these formats instead. */
+static int
+fz_test_compression_decodes_to_samples(int type)
+{
+	switch (type)
+	{
+	case FZ_IMAGE_RAW:
+	case FZ_IMAGE_FAX:
+	case FZ_IMAGE_FLATE:
+	case FZ_IMAGE_LZW:
+	case FZ_IMAGE_RLD:
+	case FZ_IMAGE_BROTLI:
+	case FZ_IMAGE_JPEG:
+	case FZ_IMAGE_JBIG2:
+		return 1;
+	default:
+		return 0;
+	}
+}
