+		 * the converter would be handed uninitialised stack memory. */
+		if (n == 0)
+		{
+			fz_warn(ctx, "image has no colour components; skipping colour analysis");
+			return;
+		}
 
 		fz_init_cached_color_converter(ctx, &cc, pix->colorspace, fz_device_rgb(ctx), NULL, NULL, color_params);
 
