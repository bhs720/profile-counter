    <PreBuildEvent>
      <Message>Building libmupdf and libtiff from the vendored submodules</Message>
      <Command>call "$(ProjectDir)patches\apply-patches.cmd" || exit /b 1
"$(MSBuildBinPath)\MSBuild.exe" "$(ProjectDir)mupdf\platform\win32\mupdf.sln" /t:libmupdf /p:Configuration=$(Configuration) /p:Platform=$(Platform) /p:PlatformToolset=$(PlatformToolset) /p:ForceImportAfterCppTargets="$(ProjectDir)static-crt.props" /nologo /v:minimal || exit /b 1
rem libtiff builds with CMake, which the C++ workload installs alongside MSBuild.
rem Fall back to whatever is on PATH if this Visual Studio lays it out differently.
set "PFC_CMAKE=$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe"
if not exist "%PFC_CMAKE%" set "PFC_CMAKE=cmake"
rem The runtime library is a configure-time setting, so Debug and Release need
rem separate build trees. CMP0091 must be NEW or CMAKE_MSVC_RUNTIME_LIBRARY is
rem silently ignored and the static CRT choice does not take effect.
set "PFC_TIFFCRT=MultiThreaded"
if /i "$(Configuration)"=="Debug" set "PFC_TIFFCRT=MultiThreadedDebug"
rem Deflate and JPEG compressed TIFFs need zlib and libjpeg, both of which mupdf
rem already vendors and links into libmupdf.lib. Building a second copy would put
rem two zlibs and two libjpegs in one binary. A static library does not resolve
rem external symbols, so libtiff only needs the headers here; the code arrives
rem when pfc-tool links libmupdf.lib. find_package still insists on a library
rem file existing, so it is pointed at libmupdf.lib, which the step above built.
rem libjpeg's generated jconfig.h lives outside its source directory, hence the
rem extra include path rather than a second JPEG_INCLUDE_DIR.
set "PFC_MUPDFLIB=$(ProjectDir)mupdf\platform\win32\$(Platform)\$(Configuration)\libmupdf.lib"
if /i "$(Platform)"=="Win32" set "PFC_MUPDFLIB=$(ProjectDir)mupdf\platform\win32\$(Configuration)\libmupdf.lib"
set "PFC_ZLIBINC=$(ProjectDir)mupdf\thirdparty\zlib"
rem mupdf keeps libjpeg's generated jconfig.h outside the library's own source
rem directory, and JPEG_INCLUDE_DIR takes a single path, so gather the headers
rem into one staging directory. Setting INCLUDE instead does not work: MSBuild
rem replaces it from its own toolchain properties before cl runs.
set "PFC_JPEGINC=$(ProjectDir)libtiff-build\jpeg-include"
if not exist "%PFC_JPEGINC%" md "%PFC_JPEGINC%" || exit /b 1
copy /y "$(ProjectDir)mupdf\thirdparty\libjpeg\*.h" "%PFC_JPEGINC%" >nul || exit /b 1
copy /y "$(ProjectDir)mupdf\scripts\libjpeg\jconfig.h" "%PFC_JPEGINC%" >nul || exit /b 1
rem Values given to -D must use forward slashes. CMake treats a backslash as an
rem escape when it writes these into the generated try_compile project, and the
rem x64 in the path becomes \x64, which it reads as a hex escape and rejects as
rem a syntax error. Forward slashes are valid paths on Windows and avoid it.
set "PFC_MUPDFLIB=%PFC_MUPDFLIB:\=/%"
set "PFC_ZLIBINC=%PFC_ZLIBINC:\=/%"
set "PFC_JPEGINC=%PFC_JPEGINC:\=/%"
rem LZMA, Zstd, WebP and LERC can each carry colour, so a TIFF using one is a
rem file whose colour is fully determinable. Leaving the codec out would make us
rem report Color=-1 for it -- an admission of our own build configuration
rem dressed up as a property of the file. mupdf vendors none of them, so each is
rem its own submodule built the same way as libtiff.
rem
rem JBIG is deliberately absent: it is a bilevel-only format, so its photometric
rem tag determines the answer and no decoder is ever needed.
rem
rem Each installs into one prefix that libtiff is then pointed at through
rem CMAKE_PREFIX_PATH. Forward slashes for the same escaping reason as above.
set "PFC_CODECPREFIX=$(ProjectDir)codec-build\install\$(Platform)\$(Configuration)"
set "PFC_CODECPREFIX=%PFC_CODECPREFIX:\=/%"
set "PFC_CODECCOMMON=-A $(Platform) -T $(PlatformToolset) -DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=%PFC_TIFFCRT% -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF -DCMAKE_INSTALL_PREFIX=%PFC_CODECPREFIX%"
rem zstd keeps its CMakeLists under build/cmake rather than at the repository root.
rem liblzma declares its API for import from a DLL unless LZMA_API_STATIC is
rem defined, so without it libtiff compiles calls to __imp_lzma_* that a static
rem build cannot satisfy. The define has to reach libtiff's own compile too,
rem hence CMAKE_C_FLAGS below rather than only here.
call :pfc_codec xz "$(ProjectDir)xz" "-DCMAKE_C_FLAGS=-DLZMA_API_STATIC" || exit /b 1
call :pfc_codec zstd "$(ProjectDir)zstd\build\cmake" "-DZSTD_BUILD_PROGRAMS=OFF -DZSTD_BUILD_TESTS=OFF -DZSTD_BUILD_SHARED=OFF -DZSTD_BUILD_STATIC=ON" || exit /b 1
call :pfc_codec libwebp "$(ProjectDir)libwebp" "-DWEBP_BUILD_ANIM_UTILS=OFF -DWEBP_BUILD_CWEBP=OFF -DWEBP_BUILD_DWEBP=OFF -DWEBP_BUILD_GIF2WEBP=OFF -DWEBP_BUILD_IMG2WEBP=OFF -DWEBP_BUILD_VWEBP=OFF -DWEBP_BUILD_WEBPINFO=OFF -DWEBP_BUILD_WEBPMUX=OFF -DWEBP_BUILD_EXTRAS=OFF" || exit /b 1
call :pfc_codec lerc "$(ProjectDir)lerc" "-DBUILD_TEST=OFF" || exit /b 1
goto :pfc_codecs_done

:pfc_codec
"%PFC_CMAKE%" -S %2 -B "$(ProjectDir)codec-build\%1\$(Platform)\$(Configuration)" %PFC_CODECCOMMON% %~3 || exit /b 1
"%PFC_CMAKE%" --build "$(ProjectDir)codec-build\%1\$(Platform)\$(Configuration)" --config $(Configuration) --target install || exit /b 1
exit /b 0

:pfc_codecs_done
set "PFC_CODECS=%PFC_CODECPREFIX%"
"%PFC_CMAKE%" -S "$(ProjectDir)libtiff" -B "$(ProjectDir)libtiff-build\$(Platform)\$(Configuration)" -A $(Platform) -T $(PlatformToolset) -DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=%PFC_TIFFCRT% -DBUILD_SHARED_LIBS=OFF -DCMAKE_PREFIX_PATH=%PFC_CODECS% -DCMAKE_C_FLAGS=-DLZMA_API_STATIC -Dtiff-tools=OFF -Dtiff-tests=OFF -Dtiff-contrib=OFF -Dtiff-docs=OFF -Dtiff-deprecated=OFF -Dtiff-install=OFF -Dzlib=ON -Djpeg=ON -DZLIB_INCLUDE_DIR=%PFC_ZLIBINC% -DZLIB_LIBRARY=%PFC_MUPDFLIB% -DJPEG_INCLUDE_DIR=%PFC_JPEGINC% -DJPEG_LIBRARY=%PFC_MUPDFLIB% -Dlzma=ON -Dzstd=ON -Dwebp=ON -Dlerc=ON -Djbig=OFF || exit /b 1
"%PFC_CMAKE%" --build "$(ProjectDir)libtiff-build\$(Platform)\$(Configuration)" --config $(Configuration) --target tiff || exit /b 1</Command>
    </PreBuildEvent>
